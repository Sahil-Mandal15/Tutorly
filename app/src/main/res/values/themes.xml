<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme - Light Mode (Modern, Clean Design) -->
    <style name="Base.Theme.Tutorly" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary Colors - Modern Blue -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/primary_lighter</item>
        <item name="colorOnPrimaryContainer">@color/primary_darker</item>

        <!-- Secondary Colors - Vibrant Red -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">#FFE5E5</item>
        <item name="colorOnSecondaryContainer">@color/secondary_dark</item>

        <!-- Tertiary Colors - Warm Amber -->
        <item name="colorTertiary">@color/tertiary</item>
        <item name="colorOnTertiary">@color/white</item>
        <item name="colorTertiaryContainer">#FFF3E0</item>
        <item name="colorOnTertiaryContainer">@color/tertiary_dark</item>

        <!-- Error Colors -->
        <item name="colorError">@color/light_error</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorErrorContainer">#FEE2E2</item>
        <item name="colorOnErrorContainer">@color/light_error</item>

        <!-- Background & Surface - Clean White -->
        <item name="android:colorBackground">@color/light_bg</item>
        <item name="colorSurface">@color/light_surface</item>
        <item name="colorOnSurface">@color/light_text_primary</item>
        <item name="colorSurfaceVariant">@color/light_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/light_text_secondary</item>

        <!-- Outline -->
        <item name="colorOutline">@color/light_outline</item>
        <item name="colorOutlineVariant">@color/light_outline_variant</item>

        <!-- Additional Theme Attributes -->
        <item name="android:statusBarColor">@color/light_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/light_bg</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Text Appearance -->
        <item name="android:textColorPrimary">@color/light_text_primary</item>
        <item name="android:textColorSecondary">@color/light_text_secondary</item>
    </style>

    <style name="Theme.Tutorly" parent="Base.Theme.Tutorly" />
</resources>